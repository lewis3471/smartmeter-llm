# Kopie nach .env und Werte eintragen
GEMINI_API_KEY=
# Mehrere Keys mit Komma anhaengen: Rotation bei 429/503
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.0-flash-lite

# Lesemodus: gemini | local (nur OCR) | hybrid (OCR + Gemini-Fallback/Check)
READER_MODE=hybrid
OCR_MIN_CONF=0.85         # darunter fragt hybrid Gemini
CROSS_CHECK_EVERY=300
SAVE_SAMPLES_DIR=/app/samples  # Trainingsdaten + Fehlerbilder (leer = aus)

# ESPHome Native API der Cam (bevorzugt, steuert auch die Blitz-LED)
ESPHOME_HOST=192.168.178.58
ESPHOME_API_KEY=
LED_BRIGHTNESS=0.45       # 30% ist die OCR-Untergrenze, 45% = sicher
GEMINI_PROMPT=Foto eines EasyMeter-Stromzaehler-LCDs mit zwei Zeilen. Zeile 1 = Zaehlerstand in kWh: IMMER exakt 6 Ziffern, ggf. mit fuehrender Null (z.B. 035774) — gib ALLE 6 Ziffern an, lass niemals die letzte Ziffer weg. Zeile 2 = aktuelle Leistung in W (1-5 Ziffern), KANN NEGATIV sein: pruefe genau, ob links ein Minuszeichen steht. Sonderfaelle: LCD-Segmenttest (beide Zeilen zeigen nur 8er) -> {"kwh":888888,"w":888888}; Display dunkel oder unlesbar -> {"kwh":0,"w":0}. Antworte NUR mit JSON: {"kwh":int,"w":int}


OPENDTU_URL=http://192.168.178.42
OPENDTU_USER=admin
OPENDTU_PASS=
INVERTER_SERIAL=

MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_PREFIX=smartmeter

# --- Regelung (Nulleinspeisung) ---
INTERVAL_S=0
TARGET_GRID_W=20
TARGET_GRID_FULL_W=-50    # Ziel bei VOLLEM Akku: etwas einspeisen ist ok
DEADBAND_W=15
MIN_LIMIT_W=50
MAX_LIMIT_W=2000
SUSTAIN_FLOOR_W=430       # Limits darunter sind nicht zuverlaessig ansteuerbar (0 = aus)          # max. AC-Leistung (HMS-2000-4T: 2000 W)
FAILSAFE_LIMIT_W=1999      # nach 3 Fehl-Lesungen in Folge

# Kamera-Modus: flash (LED pro Zyklus an/aus) | continuous (LED dauerhaft an, 1s-Takt moeglich)
CAM_MODE=continuous
GEMINI_COOLDOWN_S=30      # min. Abstand zwischen Gemini-Fallback-Calls

# --- PI-Regler (Regler v2) ---
LATENCY_S=8               # Totzeit-Guard fuer Runter-Korrekturen
PENDING_THETA_S=4         # Totzeit: eigene Schritte solange voll kompensieren
PENDING_TAU_S=2.5         # danach exponentiell abklingend (aus analyze_latency)
MIN_STEP_W=15             # Limit-Aenderungen unter X W gar nicht erst funken

# Auto-Training (Stunde 0-23, -1 = aus); Training erst nach Label-Audit
AUTO_TRAIN_HOUR=-1

LOG_LEVEL=all              # all | error | none

# --- Akku-Waechter (Victron an Strings; leer = aus) ---
BATT_STRINGS=          # z.B. 1,4 — Inverter-Eingaenge mit Akku
BATT_LOW_V=36          # darunter: Entnahme aus Akku-Strings stoppen
BATT_HIGH_V=38         # ab hier: wieder freigeben (Hysterese)
BATT_CAPACITY_KWH=0       # nutzbare Kapazitaet in kWh (0 = kein kWh-Sensor)
BATT_RI_MOHM=10           # Innenwiderstand Pack fuer die Lastkorrektur
BATT_TRIP_S=15            # so lange muss die Spannung unten liegen, bevor abgeschaltet wird
BATT_RECOVER_V=1.5        # Freigabe-Schwelle = BATT_LOW_V + dieser Wert
BATT_RELEASE_S=300     # Freigabe erst nach so lange gehaltener Spannung (Ladespannung != SoC)

# --- Zweite Quelle: Deye-Balkonwechselrichter lokal auslesen (leer = aus) ---
DEYE_HOST=             # IP des Solarman-WLAN-Loggers, z.B. 192.168.178.26
DEYE_USER=admin        # Login der Logger-Weboberflaeche
DEYE_PASS=admin
DEYE_LOGGER_SN=        # Seriennummer des WLAN-Loggers -> Modbus statt HTML-Scraping
DEYE_SLAVE=170         # Modbus-Adresse des SUN600G3 (0xAA), NICHT 1
DEYE_POLL_S=60         # Logger-Modus 'cmd': Cache ~5 min, schneller bringt nichts.
                       # Nach Umstellung auf 'throughput' echtzeitfaehig -> 5 moeglich

# --- AC-seitiger Tiefentladeschutz (Steckdose) ---
# Der HMS laesst sich per Limit nicht stilllegen (min. 50 W, und unter
# ~500 W folgt er dem Limit ohnehin nur unzuverlaessig). Erst das Trennen
# der AC-Seite stoppt die Entladung. Leer = Feature aus.
AC_SWITCH_ENTITY=              # z.B. switch.wechselrichter_ac
AC_POWER_ENTITY=               # Leistungssensor der Dose (P110/P115), optional
# Totmann: die Dose schaltet nach dieser Frist VON SELBST ab, das Add-on
# triggert sie laufend nach. Faellt WLAN/HA/Prozess aus, ist die Ruhelage AUS.
AC_DEADMAN_SWITCH_ENTITY=      # switch.<dose>_auto_off_enabled
AC_DEADMAN_NUMBER_ENTITY=      # number.<dose>_auto_off_minutes
AC_DEADMAN_AT_ENTITY=          # sensor.<dose>_auto_off_at
AC_DEADMAN_S=900               # Frist (s); nachgetriggert alle AC_KEEPALIVE_S
AC_KEEPALIVE_S=300

# BMS-Daten (OpenDTU-on-Battery). Die JK-spezifischen Topicnamen sind in
# deren Doku unvollstaendig — beim ersten Start protokolliert das Add-on,
# was wirklich ankommt, danach hier eintragen.
BATT_MQTT_PREFIX=solar/
BATT_TOPIC_CELLMIN=battery/CellMinMilliVolt
BATT_TOPIC_CELLDIFF=battery/CellDiffMilliVolt
BATT_TOPIC_SOC=battery/stateOfCharge
BATT_TOPIC_CURRENT=battery/current
BATT_TOPIC_VOLT=battery/voltage
BATT_TOPIC_DATAAGE=battery/dataAge
BATT_TOPIC_ALARM_UV=battery/alarms/underVoltage
BATT_TOPIC_ONLINE=battery/status/BatteryOnline
BATT_TOPIC_DISCHARGE_EN=battery/charging/dischargeEnabled
BATT_CURRENT_CHARGE_POSITIVE=1   # -1, falls Laden negativ gezaehlt wird
BATT_CAPACITY_AH=0               # nutzbare Kapazitaet; 0 = Float-Ersatzkriterium

# Schwellen (16S LiFePO4). Die ZELLSPANNUNG ist die Schutzgroesse, nicht
# die Packspannung: das BMS schuetzt auf die schwaechste Zelle, und der
# Victron zieht den Bus beim Laden hoch, obwohl der Akku leer ist.
AC_THROTTLE_CELL_MV=3120       # ab hier nur noch Minimallimit
AC_OFF_CELL_MV=3050            # ab hier AC trennen
AC_OFF_SOC=18
AC_HARD_CELL_MV=2900           # Notaus, 300 mV ueber dem JK-Werks-UVP
AC_ON_CELL_MV=3300             # Freigabe (Ruhespannung!)
AC_ON_SOC=50
AC_ON_DSOC=25                  # ... und so viele Punkte mehr als beim Aus
AC_ON_AH=0                     # 0 = 0,35 x BATT_CAPACITY_AH
AC_OFF_MIN_S=2700              # Mindest-Aus-Zeit
AC_MAX_SWITCH_PER_DAY=6
AC_ON_EARLIEST_H=9
AC_ON_LATEST_H=16
AC_START_BLIND_S=180           # Anlauffenster nach dem Zuschalten
AC_START_LIMIT_W=430           # Limit, mit dem er hochkommen darf
AC_AUTOMATIK=true              # false = schaltet nur ab, nie ein
